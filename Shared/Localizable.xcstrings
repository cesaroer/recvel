      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Variation between heartbeats that helps track changes in autonomic regulation and recovery."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Variación entre latidos; ayuda a observar cambios en regulación autonómica y recuperación."
          }
        }
      }
    },
    "term.met.limit": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is a population-based approximation, not an individual metabolic measurement."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una aproximación poblacional, no una medición metabólica individual."
