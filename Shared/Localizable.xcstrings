    "detail.targetCalibration.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The range combines your current Recovery with recent load. It improves as comparable days add up; it is not a quota to hit if you do not feel well."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El rango combina tu Recuperación actual con la carga reciente. Mejora al reunir días comparables; no es una cuota que debas alcanzar si no te sientes bien."
          }
        }
      }
    },
