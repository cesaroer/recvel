    "training.e1rm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated 1RM"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "1RM estimado"
          }
        }
      }
    },
    "training.e1rm.explain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An estimate of your one-rep max from weight and reps (average of Epley and Brzycki). It's only computed from sets of 10 reps or fewer, where the formulas are reliable (±5%). It's a trend estimate, not a measured 1RM."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación de tu repetición máxima a partir de peso y repeticiones (promedio de Epley y Brzycki). Solo se calcula con series de 10 reps o menos, donde las fórmulas son fiables (±5%). Es una estimación de tendencia, no un 1RM real medido."
          }
        }
      }
    },
