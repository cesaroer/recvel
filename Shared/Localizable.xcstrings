    "detail.vo2.howToImprove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What moves VO₂ max most in the literature is high-intensity interval training combined with steady aerobic volume. Changes are measured in months, not weeks."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que más mueve el VO₂ máx. en la literatura es el entrenamiento interválico de alta intensidad combinado con volumen aeróbico constante. Los cambios se miden en meses, no en semanas."
          }
        }
      }
    },
    "detail.wellnessOrientation": {
