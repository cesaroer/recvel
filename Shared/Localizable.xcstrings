    "fasting.recoveryNeedsData": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need at least 3 days with a fast of 14 h or more and 3 without, all with Recovery available. Then you can compare the association in your own data."
          }
        },
        "es-MX": {
          "stringUnit": {
