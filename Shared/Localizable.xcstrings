    "journalPro.methodology": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Patterns compare days with Yes and No answers. They are local associations and don't prove causation. Recvel needs at least 5 entries in each group before showing a difference."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los patrones comparan días con respuestas Sí y No. Son asociaciones locales y no demuestran causalidad. Recvel necesita al menos 5 registros de cada grupo antes de mostrar una diferencia."
          }
        }
      }
    },
