    "fasting.risk.talkToDoctor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to your doctor before fasting if you're an older adult, have a heart condition, or take medications that need to be timed with food."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con tu médico antes de ayunar si eres adulto mayor, tienes una condición cardiaca o tomas medicamentos que requieren horario con alimentos."
          }
        }
      }
    },
