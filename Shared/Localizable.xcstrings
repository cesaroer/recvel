    "stress.meaning.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It estimates physiological pressure from HRV SDNN and RHR against your history. It doesn't measure emotional stress, anxiety, or the cause of a change. Movement, exercise, caffeine, alcohol, illness and some medications can all influence it."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estima la presión fisiológica con HRV SDNN y RHR frente a tu historial. No mide estrés emocional, ansiedad ni la causa del cambio. El movimiento, el ejercicio, la cafeína, el alcohol, una enfermedad y algunos medicamentos pueden influir."
          }
        }
      }
    },
    "stress.meaning.title": {
      "localizations": {
