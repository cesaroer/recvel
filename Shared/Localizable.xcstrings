    "fasting.phase.autophagy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autophagy (limited evidence)"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Autofagia (evidencia limitada)"
          }
        }
      }
    },
    "fasting.phase.autophagy.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preliminary human studies suggest possible changes in autophagy markers, but the evidence isn't conclusive and comes mostly from animal studies."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estudios preliminares en humanos sugieren posibles cambios en marcadores de autofagia, pero la evidencia no es concluyente y proviene mayormente de estudios en animales."
          }
        }
      }
    },
    "fasting.phase.digesting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body is processing your last meal."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuerpo está procesando tu última comida."
          }
        }
      }
    },
    "fasting.phase.digestion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Digestion"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Digestión"
          }
        }
      }
    },
    "fasting.phase.fat.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Around these hours research suggests the body may mobilize more fat, but it depends on your prior diet, exercise and metabolism."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Alrededor de estas horas la investigación sugiere que el cuerpo puede movilizar más grasa, pero depende de tu dieta previa, ejercicio y metabolismo."
          }
        }
      }
    },
    "fasting.phase.fatTransition": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transition to fat"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Transición a grasa"
          }
        }
      }
    },
    "fasting.phase.glycogen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glycogen use"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso de glucógeno"
          }
        }
      }
    },
    "fasting.phase.glycogen.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After several hours without food, the body tends to draw more on its glycogen stores. The exact timing varies between people."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras varias horas sin comer, el cuerpo suele recurrir más a sus reservas de glucógeno. El momento exacto varía entre personas."
          }
        }
      }
    },
    "fasting.phase.liver.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liver glycogen tends to run out around 18-24 h; it's one of the better-supported physiological estimates, though it's still individual."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El glucógeno del hígado tiende a agotarse alrededor de las 18-24 h; es una de las estimaciones con mejor respaldo fisiológico, aunque sigue siendo individual."
          }
        }
      }
    },
    "fasting.phase.lowLiverGlycogen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low liver glycogen"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Glucógeno hepático bajo"
          }
        }
      }
    },
