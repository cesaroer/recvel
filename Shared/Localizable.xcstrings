    "advice.load.inRange.detail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current Load matches your estimated capacity. Maintaining it or finishing with light activity are complete choices; you do not need to reach the upper limit."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
