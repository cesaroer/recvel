    "training.disclaimer": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load is a wellness estimate based on duration, heart-rate zones and your personal baseline. It does not predict injuries nor replace a professional assessment."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La Carga es una estimación de bienestar basada en duración, zonas de frecuencia cardíaca y tu referencia personal. No predice lesiones ni sustituye una evaluación profesional."
          }
        }
      }
    },
    "training.disclaimer.trend": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the trend alongside how you feel, rest and context. Recvel doesn't diagnose or predict injuries."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la tendencia junto con sensaciones, descanso y contexto. Recvel no diagnostica ni predice lesiones."
          }
        }
      }
    },
