    },
    "advice.energy.high.detail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can prioritize a demanding task or session. Keep margin within your Load range and reassess if how you feel does not match the data."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes priorizar una tarea o sesión exigente. Conserva margen dentro de tu rango de Carga y reevalúa si tus sensaciones no coinciden con los datos."
          }
        }
      }
    },
    "advice.energy.high.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacity is available"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay capacidad disponible"
          }
        }
      }
    },
    "advice.energy.low.detail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce optional intense effort and focus important work into fewer blocks. A consistent night and moderate Load are the levers Recvel can observe."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce el esfuerzo intenso opcional y concentra lo importante en menos bloques. Una noche estable y una Carga moderada son las palancas que Recvel puede observar."
          }
        }
      }
    },
    "advice.energy.low.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect your remaining capacity"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege el margen restante"
          }
        }
      }
    },
    "advice.energy.moderate.detail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have moderate capacity. Alternate demanding tasks with lower-demand periods and avoid raising Load just because the day is not over."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes capacidad intermedia. Alterna tareas exigentes con periodos de menor demanda y evita aumentar la Carga solo porque el día aún no termina."
          }
        }
      }
    },
    "advice.energy.moderate.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work at a sustainable pace"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja a un ritmo sostenible"
          }
        }
      }
    },
    "advice.load.covered.detail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not need to compensate further today. Spreading activity across the week is usually more useful than concentrating it in one session."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas compensar nada más hoy. Distribuir la actividad durante la semana suele ser más útil que concentrarla en una sola sesión."
          }
        }
      }
    },
    "advice.load.covered.title": {
      "extractionState": "stale",
