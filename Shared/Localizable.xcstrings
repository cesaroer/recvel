    "detail.sleep.recoverGradual": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovering is gradual: adding 30-60 min per night works better than one long night. Weekend sleep only makes up for part of it."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperar es gradual: sumar 30-60 min por noche rinde más que una sola noche larga. El sueño de fin de semana compensa solo en parte."
          }
        }
      }
    },
