    "vo2.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An estimate of your cardiorespiratory fitness based on outdoor walks, runs or hikes recorded by Apple Watch."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Una estimación de tu capacidad cardiorrespiratoria basada en caminatas, carreras o senderismo al aire libre registrados por Apple Watch."
          }
        }
      }
    },
    "vo2.newEstimate.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do an outdoor walk, run or hike of at least 20 minutes, with good GPS signal and enough intensity. Apple decides when to save a sample."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una caminata, carrera o sesión de senderismo al aire libre de al menos 20 minutos, con buena señal GPS e intensidad suficiente. Apple determina cuándo guardar una muestra."
          }
        }
      }
    },
    "vo2.newEstimate.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to get a new estimate"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo obtener una nueva estimación"
          }
        }
      }
    },
    "vo2.noSamples": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No samples in Apple Health"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin muestras en Apple Health"
          }
        }
      }
    },
    "vo2.notLab.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch uses a submaximal prediction. It's more useful for tracking changes over several weeks than for reading decimals or comparing devices."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch utiliza una predicción submáxima. Es más útil para seguir cambios durante varias semanas que para interpretar decimales o comparar dispositivos."
          }
        }
      }
    },
    "vo2.notLab.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's an estimate, not a lab test"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una estimación, no una prueba de laboratorio"
          }
        }
      }
