          "stringUnit": {
            "state": "translated",
            "value": "What time did you actually stop eating?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A qué hora dejaste de comer realmente?"
          }
        }
      }
    },
