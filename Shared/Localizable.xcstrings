    "advice.daylight.low": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You recorded little daylight today ({value} min). A short walk in natural light may support alertness without adding much Load."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy registraste poca luz diurna ({value} min). Un paseo breve con luz natural puede favorecer la alerta sin aumentar demasiado la Carga."
          }
        }
      }
    },
    "advice.energy.eyebrow": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RECOMMENDED PACE"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "RITMO RECOMENDADO"
          }
        }
