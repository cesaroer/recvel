    "stress.emotion.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your log stays on the device and adds context. Recvel does not infer emotions from your signals. It is a self-knowledge tool, not a diagnostic one."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu registro permanece en el dispositivo y aporta contexto. Recvel no infiere emociones a partir de tus señales. Es una herramienta de autoconocimiento, no de diagnóstico."
          }
        }
      }
    },
