    },
    "No existe una espera universal de 48 h. La frecuencia puede organizarse de distintas formas cuando el volumen semanal se iguala; la respuesta individual ayuda a decidir (Ramos-Campo et al. 2024, PMID 38595233)." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no universal 48 h wait. Frequency can be organized in different ways when weekly volume is equated; your individual response helps you decide (Ramos-Campo et al. 2024, PMID 38595233)."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No existe una espera universal de 48 h. La frecuencia puede organizarse de distintas formas cuando el volumen semanal se iguala; la respuesta individual ayuda a decidir (Ramos-Campo et al. 2024, PMID 38595233)."
          }
        }
      }
    },
