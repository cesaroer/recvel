        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La consistencia y el volumen semanal aportan más contexto que un solo entrenamiento. Los minutos incluyen Apple Health y registros manuales confirmados."
          }
        }
      }
    },
    "training.explain.cardioFocus": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low zones favor sustainable aerobic volume; high and anaerobic zones raise intensity. The right mix depends on your sport and goal."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las zonas bajas favorecen volumen aeróbico sostenible; las altas y anaeróbicas aumentan intensidad. La mezcla adecuada depende del deporte y objetivo."
          }
        }
      }
    },
    "training.explain.cardioLoad": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load combines time in heart rate zones. When zones are missing, it falls back to duration with low confidence. Watch it over several weeks."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga combina tiempo en zonas de frecuencia cardiaca. Cuando faltan zonas, usa duración como fallback de baja confianza. Observa varias semanas."
          }
        }
      }
    },
    "training.explain.hrr": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart rate recovery is the drop during the first minute after you stop. Hydration, heat, posture and how you end the workout can all change it."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación de la frecuencia cardíaca es la disminución durante el primer minuto después de terminar. La hidratación, el calor, la postura y la forma de detener el entrenamiento pueden modificarla."
          }
        }
      }
    },
    "training.explain.strain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It compares your daily Load against a range adjusted to your Recovery. It's for modulating effort; it isn't a quota or a risk prediction."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara tu Carga diaria con un rango ajustado según tu Recuperación. Sirve para modular el esfuerzo; no es una cuota ni una predicción de riesgo."
          }
        }
      }
    },
    "training.explain.strength": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmed frequency and volume let you watch progression. Recvel doesn't infer sets, reps or weight from a generic HealthKit workout."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La frecuencia y el volumen confirmados permiten observar la progresión. Recvel no infiere series, repeticiones ni peso desde un entrenamiento genérico de HealthKit."
          }
        }
      }
    },
    "training.finishRoutine": {
