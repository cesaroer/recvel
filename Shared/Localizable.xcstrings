        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las diferencias son asociaciones locales y no prueban causalidad. Solo aparecen con al menos 5 registros Sí y 5 No vinculados a la Recuperación del mismo día. Un dato sin registrar permanece como desconocido."
          }
        }
      }
