    "fasting.thisWeek": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana"
          }
        }
      }
    },
    "fasting.tip.avoidHeavy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid very heavy or processed meals right after you finish."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita comidas muy pesadas o procesadas justo al terminar."
          }
        }
      }
    },
    "fasting.tip.avoidStart": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid starting a long fast if you slept badly or had a physically demanding day."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita empezar un ayuno largo si dormiste mal o tuviste un día físicamente muy exigente."
          }
        }
      }
    },
    "fasting.tip.breakIfDizzy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you feel dizzy, very weak or confused, break the fast. Your wellbeing comes first."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sientes mareo, debilidad intensa o confusión, rompe el ayuno. Tu bienestar es primero."
          }
        }
      }
    },
    "fasting.tip.breakLight": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Break the fast with something light: fruit, yogurt, a handful of nuts."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Rompe el ayuno con algo ligero: fruta, yogurt, un puñado de nueces."
          }
        }
      }
    },
    "fasting.tip.dinner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dinner with fiber and protein can make the first hours of fasting easier."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cena con fibra y proteína puede facilitar las primeras horas de ayuno."
          }
        }
      }
    },
    "fasting.tip.distract": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distracting your mind with a task or activity can reduce the feeling of hunger."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Distraer la mente con una tarea o actividad puede reducir la sensación de hambre."
          }
        }
      }
    },
    "fasting.tip.hydrateBefore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hydrate well before you start. Water, tea or unsweetened coffee are your allies."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidrátate bien antes de empezar. El agua, té o café sin azúcar son tus aliados."
          }
        }
      }
    },
    "fasting.tip.lightActivity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light activity like walking can make the wait easier."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Actividad ligera como caminar puede hacer más llevadera la espera."
          }
        }
      }
    },
    "fasting.tip.stayHydrated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay hydrated. Sparkling water, green tea or black coffee don't break the fast."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente hidratado. El agua con gas, té verde o café negro no rompen el ayuno."
          }
        }
      }
    },
    "fasting.tip.wait": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give your body 15-20 minutes before a large meal."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale a tu cuerpo 15-20 minutos antes de una comida grande."
          }
        }
      }
    },
    "fasting.tip.waves": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hunger comes in waves — it usually passes if you give it a few minutes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El hambre viene en oleadas — suele pasar si le das unos minutos."
          }
        }
      }
    },
    "fasting.whatHappens": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happens during a fast"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué ocurre durante el ayuno"
          }
        }
      }
    },
    "fasting.whenDidYouStop": {
      "localizations": {
