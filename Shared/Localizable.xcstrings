    "advice.load.easy.detail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Recovery reduces the recommended margin. If it matches how you feel, choose conversational-pace activity or mobility."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Recuperación reduce el margen recomendado. Si coincide con cómo te sientes, elige actividad a ritmo conversacional o movilidad."
          }
        }
      }
    },
    "advice.load.easy.title": {
